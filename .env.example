# ChronoProof identity hub (Express + Bun)
# Runtime: Bun (bun run src/server.ts)
# NOTE: Azure App Service does not ship Bun natively. Either add a startup
# script that installs Bun, or use a custom container image that includes Bun.
PORT=3000
ISSUER=https://auth.chronoproof.com
AUDIENCE=chrono-services
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Azure SQL (NO Docker). Point at a real, reachable Azure SQL / SQL Server —
# e.g. DB_SERVER=your-server.database.windows.net. In Azure App Service the
# DB_PASSWORD is a Key Vault reference App Setting, never a committed value.
DB_SERVER=your-server.database.windows.net
DB_PORT=1433
DB_NAME=chronoproof
DB_USER=chronoproof_admin
DB_PASSWORD=
DB_ENCRYPT=true

# RS256 signing keys. In Azure App Service these are Key Vault reference App
# Settings whose resolved VALUE is the PEM string (not a file path):
#   JWT_PRIVATE_KEY = @Microsoft.KeyVault(SecretUri=https://<vault>/secrets/chronoproof-jwt-private-key/)
# The public key is not secret and is served via /.well-known/jwks.json.
JWT_KEY_ID=chronoproof-key-1
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Local dev fallback only (gitignored PEM files in keys/):
# JWT_PRIVATE_KEY_PATH=keys/private.pem
# JWT_PUBLIC_KEY_PATH=keys/public.pem

# Refresh cookie + CORS
COOKIE_DOMAIN=.chronoproof.com
CORS_ALLOWED_ORIGINS=https://app.chronoproof.com

# SMTP — invitation email delivery. Real values live in .env / Azure Key Vault only.
# Port 587 = STARTTLS, 465 = implicit TLS. SMTP_PASSWORD must never be committed.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=
EMAIL_FROM="ChronoProof <noreply@example.com>"
# Frontend base for the invite accept link (…/accept-invite?token=…)
APP_BASE_URL=https://app.chronoproof.com
