[config]
SCM_DO_BUILD_DURING_DEPLOYMENT=true
; Startup Command must be: bun run src/server.ts
; NOTE: Azure App Service does NOT ship Bun natively. You must either:
;   1. Use a startup script that installs Bun first (e.g., curl -fsSL https://bun.sh/install | bash && bun run src/server.ts)
;   2. Use a custom container that includes Bun
